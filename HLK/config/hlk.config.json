{
  "hlk_enabled": true,
  "version": "3.0.0",
  "description": "Harness & Logic Knowledge Layer config",
  "features": {
    "knowledge_protection": true,
    "data_sanitization": true,
    "secret_vault_override": true,
    "telemetry_blocker": true,
    "custom_hooks_injection": true,
    "post_merge_verify": true
  },
  "upgrade_policy": {
    "auto_merge": false,
    "verify_hlk_after_merge": true,
    "backup_config_before_merge": true,
    "log_upgrades": true
  },
  "security_rules": {
    "redact_patterns": [
      "sk-[a-zA-Z0-9]{32,}",
      "ghp_[a-zA-Z0-9]{36}",
      "\\b(sk-|pk-|api[_-]?key[_-]?)[a-zA-Z0-9]{20,}\\b",
      "\\beyJ[a-zA-Z0-9_-]*\\.eyJ[a-zA-Z0-9_-]*\\.[a-zA-Z0-9_-]*\\b",
      "(?i)password\\s*=\\s*['\"]?[^'\"\\s]+",
      "(?i)api[_-]?key\\s*=\\s*['\"]?[^'\"\\s]+",
      "(?i)secret\\s*[:=]\\s*['\"]?[^'\"\\s]+",
      "(?i)token\\s*[:=]\\s*['\"]?[^'\"\\s]+",
      "(?i)-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----[\\s\\S]*?-----END (RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "AKIA[0-9A-Z]{16}",
      "(?i)aws[_-]?secret[_-]?access[_-]?key\\s*=\\s*['\"]?[A-Za-z0-9/+=]{40}",
      "(?i)aws[_-]?session[_-]?token\\s*=\\s*['\"]?[A-Za-z0-9/+=]{40,}",
      "(?i)Bearer\\s+[A-Za-z0-9._-]+",
      "(?i)(mongodb\\+srv|postgresql|postgres|mysql|redis|amqp)://[^:\\s]+:[^@\\s]+@[^/\\s]+",
      "(?i)(mongodb\\+srv|postgresql|postgres|mysql|redis|amqp)://:[^@\\s]+@[^/\\s]+",
      "AIza[0-9A-Za-z_-]{22,}",
      "xox[baprs]-[0-9A-Za-z-]+",
      "(sk|pk|rk)_(live|test)_[0-9a-zA-Z]{24,}",
      "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "[a-z]+://[^:\\s]+:[^@\\s]+@[^/\\s]+",
      "glpat-[A-Za-z0-9_-]{20}",
      "github_pat_[A-Za-z0-9_]{22,}",
      "npm_[A-Za-z0-9]{36}",
      "SG\\.[a-zA-Z0-9_-]{22}\\.[a-zA-Z0-9_-]{43}",
      "AIzaSy[A-Za-z0-9_-]{33,}",
      "AC[a-z0-9]{32}",
      "SK[a-z0-9]{32}",
      "pub[a-f0-9]{32}",
      "(?i)datadog[_-]?(api|app)[_-]?key\\s*=\\s*['\"]?[a-f0-9]{32}"
    ],
    "redact_replacement": "[REDACTED]",
    "scan_paths": [
      "src/**",
      "config/**",
      ".env*"
    ],
    "exclude_paths": [
      "node_modules/**",
      "dist/**",
      "HLK/logs/**"
    ],
    "reviewer_keys": [],
    "approval_signature_required": false,
    "failClosedOnConfigError": true,
    "secretPrecedence": "file>env"
  },
  "telemetry_overrides": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_TELEMETRY": "1",
    "OTEL_TRACES_EXPORTER": "none",
    "OTEL_METRICS_EXPORTER": "none",
    "OTEL_LOGS_EXPORTER": "none",
    "LANGSMITH_TRACING": "false",
    "LANGFUSE_TRACING": "false"
  }
}
