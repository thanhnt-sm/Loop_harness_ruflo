# HLK secrets template — copy sang secrets.env và điền giá trị thật.
# File này KHÔNG chứa secret thật (toàn bộ giá trị là placeholder example-*).
# HLK/config/secrets.env bị gitignore; riêng file .example được track để verify pipeline PASS.

AIDE_MEMORY_API_KEY=example-change-me
