    "hlk-upstream-pull": "upstream/hlk-upstream-pull.mjs",
    "hlk-git-doctor": "git-tools/hlk-git-doctor.mjs",
    "hlk-git-commit": "git-tools/hlk-git-commit.mjs",
    "hlk-git-push": "git-tools/hlk-git-push.mjs",
