# .coveragerc — cấu hình coverage cho AHD.
# Source: thư mục .devin (scripts + hooks).
# Bỏ qua các file test, venv, và HLK runtime artifacts.

[run]
source =
    .devin
    tools

omit =
    */tests/*
    */test_*/*
    */.venv/*
    */venv/*
    HLK/*
    .devin/state/*
    .devin/plan_state/*
    .devin/loop_state/*
    .devin/session_state/*
    .devin/telemetry/*

[report]
fail_under = 80
show_missing = true
skip_covered = false
