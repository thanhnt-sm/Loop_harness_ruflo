{
  "_description": "U40: Minimum viable harness config — graceful degradation mode",
  "_version": "1.0.0",
  "_created": "2026-07-07",
  "_u40_note": "Used when component failures detected by BOOT. Only essential hooks + permissions.",

  "permissions": {
    "allow": [
      "Read(**)",
      "Exec(git status)",
      "Exec(git diff:*)",
      "Exec(git log:*)",
      "Exec(python scripts/*)",
      "Exec(python .devin/scripts/*)",
      "Exec(node scripts/*)"
    ],
    "deny": [
      "Exec(sudo)",
      "Exec(rm -rf:*)",
      "Exec(git push --force:*)",
      "Exec(git push -f:*)",
      "Exec(git reset --hard:*)",
      "Exec(git clean -fd:*)",
      "Exec(format:*)",
      "Exec(shred:*)",
      "Read(.env)",
      "Read(.env.*)"
    ],
    "ask": [
      "Exec(git commit)",
      "Exec(git push)",
      "Exec(git merge:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash|Shell|Execute|exec|terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python .devin/hooks/pre_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .devin/hooks/post_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .devin/hooks/stop.py",
            "timeout": 5
          }
        ]
      }
    ]
  },

  "_minimal_mode_exclusions": {
    "disabled_hooks": [
      "HLK security hooks (hlk-hook-launcher.mjs)",
      "aide-memory hooks (session-start-clear, pre-compact-save, stop-remember, detect-correction, pre-read-recall, pre-edit-recall, pre-search-nudge, track-recall, track-remember, track-search)"
    ],
    "disabled_features": [
      "MCP servers (aide-memory, spark-memory, deepwiki, devin)",
      "Skills auto-invocation",
      "Context compaction",
      "Memory recall/remember",
      "Cost tracking",
      "SHA tracking",
      "Risk contract warnings"
    ],
    "kept_essential": [
      "pre_tool_use.py — security guard (dangerous command blocking)",
      "post_tool_use.py — session state tracking",
      "stop.py — session cleanup",
      "ahd_session.py — shared session utilities"
    ]
  }
}
