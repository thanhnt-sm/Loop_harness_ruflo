(version 1)
(deny default (with no-log))
(allow process-exec (with no-log)
  (literal "/usr/bin/python3")
  (literal "/opt/homebrew/bin/python3")
  (literal "/usr/bin/env"))
(allow file-read* (with no-log)
  (regex "^/Volumes/Data/101\\.AI/GitHub/Loop_harness_ruflo/"))
(allow file-write* (with no-log)
  (regex "^/Volumes/Data/101\\.AI/GitHub/Loop_harness_ruflo/\.devin/"))
(allow network* (with no-log)
  (regex "^127\\.0\\.0\\.1:"))
(deny process-exec (literal "/bin/bash") (literal "/bin/sh") (literal "/bin/zsh"))
