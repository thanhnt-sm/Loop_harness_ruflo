{
  "version": 1,
  "tags": {
    "presets": [
      "architecture",
      "testing",
      "security",
      "style",
      "integration",
      "config",
      "migration",
      "performance",
      "api-contract"
    ]
  },
  "telemetry": {
    "enabled": true
  },
  "contributor": "thanhnt-sm",
  "embeddings": {
    "model": "auto",
    "backend": "auto"
  },
  "updates": {
    "check": true
  },
  "hooks": {
    "read": {
      "maxBlocks": 1
    },
    "edit": {
      "maxBlocks": 1
    },
    "stop": {
      "schedule": [
        {
          "until": 9,
          "every": 3
        },
        {
          "until": 29,
          "every": 5
        },
        {
          "every": 10
        }
      ],
      "mode": "block"
    },
    "search": {
      "mode": "soft"
    },
    "correction": {
      "enabled": true,
      "escalate": "off"
    },
    "precompact": {
      "mode": "cleanup"
    },
    "visible": true
  },
  "recall": {
    "limit": 20,
    "ensureLayerDiversity": true,
    "layerDiversityMinLimit": 5,
    "minScopeDepth": 1
  },
  "injection": {
    "enabled": true,
    "preferences": 15,
    "excludeScopedPreferences": false,
    "technical": false,
    "area_context": false,
    "guidelines": "all",
    "priorityAlwaysOverride": true,
    "maxChars": 1200
  },
  "memories": {
    "hideFromGrep": true,
    "softening": {
      "threshold": 10
    },
    "defaultShared": true
  }
}
