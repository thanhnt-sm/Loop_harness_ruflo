{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git pull": "ask",
      "git push": "ask",
      "git push --force": "deny",
      "git push -f": "deny",
      "git force-push": "deny",
      "rm -rf *": "deny",
      "rm -rf": "deny",
      "drop table": "deny",
      "sudo": "ask",
      "curl *|*sh": "deny",
      "curl * -o *|*sh": "deny",
      "wget *|*sh": "deny",
      "mkfs*": "deny",
      "chmod -R 777 *": "deny",
      "python* -c \"import os*": "deny"
    },
    "external_directory": { "*": "ask" }
  }
}
